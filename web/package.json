{
  "name": "multi-delivery-route-planner",
  "version": "1.0.0",
  "private": true,
  "description": "Multi-delivery route planner: C++ graph engine (Dijkstra, min-heap, NN, 2-opt, Held-Karp) with a Next.js UI",
  "scripts": {
    "engine:build": "node scripts/build-engine.mjs",
    "engine:test": "node scripts/build-engine.mjs --test",
    "predev": "node scripts/build-engine.mjs --if-missing",
    "dev": "next dev",
    "prebuild": "node scripts/build-engine.mjs --if-missing",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:all": "node scripts/build-engine.mjs --test && vitest run",
    "demo:generate": "node scripts/generate-demo-data.mjs"
  },
  "dependencies": {
    "leaflet": "1.9",
    "lucide-react": "^1.63.0",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-leaflet": "^5.0.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
